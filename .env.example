# ============================================
# QuizFlow22 — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# --- Supabase (required for auth & data persistence) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public Yandex API Gateway and optional SEO analytics.
VITE_API_URL=https://your-api-gateway.apigw.yandexcloud.net/api
VITE_YANDEX_METRIKA_ID=

# --- AI Proxy Backend (optional override) ---
# By default the frontend calls the Supabase Edge Function at:
#   ${VITE_SUPABASE_URL}/functions/v1/ai-proxy
# Override only if you host the proxy elsewhere (e.g. behind Yandex API Gateway).
# Example: VITE_AI_PROXY_URL=https://your-project-id.supabase.co/functions/v1/ai-proxy
# VITE_AI_PROXY_URL=

# --- Yandex Cloud deployment (used by deploy scripts, NOT by the app) ---
# Object Storage bucket name (must be globally unique within Yandex Cloud).
YC_BUCKET=quizflow22-prod
# Yandex Cloud CDN resource ID (for cache invalidation after deploy). Optional.
YC_CDN_RESOURCE_ID=
# AWS-compatible credentials for Yandex Object Storage (static access key from
# the service account with storage.editor role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3-compatible endpoint for Yandex Object Storage.
YC_S3_ENDPOINT=https://storage.yandexcloud.net

# --- Backend-only variables (never use VITE_ prefix!) ---
# These are used by the Supabase Edge Function, NOT the frontend.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OPENROUTER_API_KEY=your-openrouter-api-key
# GEMINI_API_KEY=your-gemini-api-key
# AI_PROXY_ALLOWED_ORIGINS=https://your-cdn-domain.example,https://your-bucket.website.yandexcloud.net
