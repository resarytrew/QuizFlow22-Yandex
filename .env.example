# Public frontend configuration. Production uses the same-origin CDN route.
VITE_API_URL=/api
VITE_PRIMARY_SITE_URL=https://mykviz.ru
VITE_ADDITIONAL_SITE_ORIGINS=https://mykviz.online

# Yandex Object Storage / CDN deployment.
YC_BUCKET=quizflow22-prod
YC_CDN_RESOURCE_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
YC_S3_ENDPOINT=https://storage.yandexcloud.net

# Backend-only values belong in Yandex Lockbox, never in VITE_* variables.
# PG_HOST=
# PG_PORT=6432
# PG_DATABASE=potok
# PG_USER=
# PG_PASSWORD=
# PG_CA_CERT=
# OTP_PEPPER=
# SESSION_PEPPER=
# MFA_ENCRYPTION_KEY=
# YANDEX_OAUTH_CLIENT_ID=
# YANDEX_OAUTH_CLIENT_SECRET=
# POSTBOX_SMTP_USER=
# POSTBOX_SMTP_PASSWORD=
# POSTBOX_FROM_EMAIL=
# POSTBOX_FROM_NAME=Поток
# FRONTEND_URL=https://mykviz.ru
# ALLOWED_ORIGINS=https://mykviz.ru,https://mykviz.online
