    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "build:engine": "rollup -c build/rollup.engine.config.js",
    "build": "npm run build:engine && vite build && node scripts/prerender-seo.mjs"
