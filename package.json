  "scripts": {
    "predev": "npm run build:engine",
    "dev": "vite",
    "lint": "tsc --noEmit",
    "lint:functions": "npx tsc -p yc-functions/tsconfig.json --noEmit",
    "test:functions": "npm --prefix yc-functions run build",
    "pretest": "npm run build:engine",
    "test": "vitest run",
    "pretest:watch": "npm run build:engine",
