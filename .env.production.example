# Public frontend configuration
VITE_SUPABASE_URL=https://lntsyybfbunajmzbahrq.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
VITE_API_URL=https://replace-with-api-gateway-id.apigw.yandexcloud.net/api

# Both domains serve the same production build.
VITE_PRIMARY_SITE_URL=https://mykviz.ru
VITE_ADDITIONAL_SITE_ORIGINS=https://mykviz.online

# Yandex Object Storage / CDN deployment
YC_BUCKET=quizflow22-prod
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_CDN_RESOURCE_ID=replace-with-yandex-cdn-resource-id
AWS_ACCESS_KEY_ID=replace-with-static-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-static-secret-key

# Configure these as Supabase Auth SMTP environment variables/secrets:
# SUPABASE_AUTH_SMTP_USER=replace-with-yandex-mailbox
# SUPABASE_AUTH_SMTP_PASS=replace-with-yandex-app-password
# SUPABASE_AUTH_SMTP_ADMIN_EMAIL=replace-with-yandex-mailbox
#
# Configure backend secrets in Yandex Cloud Functions / API Gateway:
# SUPABASE_URL=https://lntsyybfbunajmzbahrq.supabase.co
# DATABASE_URL=postgres://...
# YC_CATALOG_ID=...
# YC_OAUTH_TOKEN=...
# S3_BUCKET=...
# S3_ENDPOINT=https://storage.yandexcloud.net
# BILLING_RETURN_URL=https://mykviz.ru
