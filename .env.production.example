VITE_API_URL=/api
VITE_PRIMARY_SITE_URL=https://mykviz.ru
VITE_ADDITIONAL_SITE_ORIGINS=https://mykviz.online

YC_BUCKET=quizflow22-prod
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_CDN_RESOURCE_ID=replace-with-yandex-cdn-resource-id
AWS_ACCESS_KEY_ID=replace-with-static-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-static-secret-key

# Add backend values to Yandex Lockbox and bind them to the unified API function.
# OTP_PEPPER: at least 32 random bytes
# SESSION_PEPPER: at least 32 random bytes
# MFA_ENCRYPTION_KEY: exactly 32 bytes encoded as base64 or 64 hex characters
# YANDEX_OAUTH_CLIENT_ID: application ID from oauth.yandex.ru
# YANDEX_OAUTH_CLIENT_SECRET: application secret from oauth.yandex.ru
# POSTBOX_SMTP_USER: Postbox static access-key ID or IAM_TOKEN
# POSTBOX_SMTP_PASSWORD: Postbox static secret or service-account IAM token
# POSTBOX_FROM_EMAIL: verified Postbox sender, for example no-reply@mykviz.ru
# POSTBOX_FROM_NAME: Поток
# FRONTEND_URL: https://mykviz.ru
# ALLOWED_ORIGINS: https://mykviz.ru,https://mykviz.online
